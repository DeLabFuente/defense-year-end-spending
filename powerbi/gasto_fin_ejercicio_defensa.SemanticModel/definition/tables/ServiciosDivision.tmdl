	partition ServiciosDivision = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "servicios_cpv_division.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Vacios = Table.ReplaceValue(Limpio, "", null, Replacer.ReplaceValue, Table.ColumnNames(Limpio)),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"orden", Int64.Type}, {"cpv_division", type text}, {"division", type text}, {"importe_defensa_meur", type number}, {"peso_en_servicios_defensa", type number}, {"adjudicaciones_defensa", Int64.Type}, {"cuota_nov_dic_defensa", type number}, {"cuota_nov_dic_resto_age", type number}, {"diferencia_puntos", type number}, {"aportacion_a_la_diferencia_puntos", type number}, {"anios_defensa_por_encima", type text}, {"salto_oferta_unica_defensa_puntos", type number}, {"salto_oferta_unica_resto_age_puntos", type number}}, "es-ES")
				in
				    Tipos

	annotation PBI_ResultType = Table

