				    Tipos = Table.TransformColumnTypes(Vacios, {{"orden", Int64.Type}, {"variante", type text}, {"descripcion", type text}, {"adjudicaciones_defensa", Int64.Type}, {"cuota_nov_dic_defensa", type number}, {"cuota_nov_dic_resto_age", type number}, {"diferencia_puntos", type number}, {"anios_defensa_por_encima", type text}, {"salto_oferta_unica_defensa_puntos", type number}, {"salto_oferta_unica_resto_age_puntos", type number}, {"salto_negociado_defensa_puntos", type number}, {"salto_negociado_resto_age_puntos", type number}, {"cuota_servicios_defensa", type number}, {"cuota_servicios_resto_age", type number}}, "es-ES")
				in
				    Tipos

	annotation PBI_ResultType = Table

