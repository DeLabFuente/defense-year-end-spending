	partition RobustezCalendario = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "robustez_calendario.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Vacios = Table.ReplaceValue(Limpio, "", null, Replacer.ReplaceValue, Table.ColumnNames(Limpio)),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"orden", Int64.Type}, {"ventana_dias_habiles", Int64.Type}, {"medida", type text}, {"cambio_mediano_defensa", type number}, {"anios_que_cae_defensa", type text}, {"cambio_mediano_resto_age", type number}, {"anios_que_cae_resto_age", type text}}, "es-ES")
				in
				    Tipos

	annotation PBI_ResultType = Table

