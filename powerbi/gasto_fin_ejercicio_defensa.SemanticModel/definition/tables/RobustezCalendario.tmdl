	column orden
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 517086e6-e796-4b8b-b21c-15b5fd7c09ed
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = Automatic

