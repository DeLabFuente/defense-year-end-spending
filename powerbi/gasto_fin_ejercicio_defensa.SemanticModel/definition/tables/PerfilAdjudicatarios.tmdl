	column mediana_cuota_negociado_sin_publicidad
		dataType: double
		formatString: 0.0%
		lineageTag: 214be55b-3a03-4617-933c-ed11af5fbb46
		summarizeBy: none
		sourceColumn: mediana_cuota_negociado_sin_publicidad

		annotation SummarizationSetBy = Automatic

	column mediana_organos
		dataType: double
		formatString: 0.0
		lineageTag: 1c49be85-aae0-4e0e-b277-a9dc1ecf7a0a
		summarizeBy: none
		sourceColumn: mediana_organos

		annotation SummarizationSetBy = Automatic

	column con_alguna_senal
		dataType: int64
		formatString: #,0
		lineageTag: 9c9efc60-3cda-4755-9cd1-37eee40ae3e7
		summarizeBy: none
		sourceColumn: con_alguna_senal

		annotation SummarizationSetBy = Automatic

	partition PerfilAdjudicatarios = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "adjudicatarios_perfil.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Vacios = Table.ReplaceValue(Limpio, "", null, Replacer.ReplaceValue, Table.ColumnNames(Limpio)),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"perfil", type text}, {"orden_perfil", Int64.Type}, {"tramo_importe", type text}, {"adjudicatarios", Int64.Type}, {"suprimido", type text}, {"mediana_anios", type number}, {"mediana_adjudicaciones", type number}, {"mediana_divisiones_cpv", type number}, {"mediana_cuota_division_principal", type number}, {"mediana_cuota_nov_dic_n", type number}, {"mediana_cuota_oferta_unica", type number}, {"mediana_cuota_negociado_sin_publicidad", type number}, {"mediana_organos", type number}, {"con_alguna_senal", Int64.Type}}, "es-ES")
				in
				    Tipos

	annotation PBI_ResultType = Table

