	partition Macro = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "macro_2017_2026.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
