	partition Picos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "picos_cierre.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Vacios = Table.ReplaceValue(Limpio, "", null, Replacer.ReplaceValue, Table.ColumnNames(Limpio)),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"nivel", type text}, {"anio", Int64.Type}, {"rama", type text}, {"organo", type text}, {"importe_anio_eur", type number}, {"importe_nov_dic_eur", type number}, {"cuota_nov_dic", type number}, {"importe_ordinario_anio_eur", type number}, {"importe_ordinario_nov_dic_eur", type number}, {"cuota_nov_dic_ordinaria", type number}, {"cuota_emergencia_nov_dic", type number}, {"cuota_mayor_expediente_nov_dic", type number}, {"cuota_negociado_sp_nov_dic", type number}, {"cuota_renovacion_anual_nov_dic", type number}, {"clasificacion", type text}, {"motivo", type text}, {"notas", type text}, {"sucesos_del_ultimo_cuatrimestre", type text}}, "es-ES"),
				    Final = Table.AddColumn(Tipos, "importe_nov_dic_meur", each [importe_nov_dic_eur] / 1000000, type number)
				in
				    Final

	annotation PBI_ResultType = Table

