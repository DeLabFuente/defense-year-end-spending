	measure 'Negociado sin publicidad ene-oct línea base' = DIVIDE ( CALCULATE ( SUM ( LineaBase[n_negociado_sin_publicidad] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ), KEEPFILTERS ( LineaBase[mes] <= 10 ) ), CALCULATE ( SUM ( LineaBase[n_ordinario] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ), KEEPFILTERS ( LineaBase[mes] <= 10 ) ) )
		formatString: 0.0%
