	/// Parte de las adjudicaciones del año en cada quincena, media de 2017 a 2025.
	measure 'Peso de la quincena (n.º)' = CALCULATE ( AVERAGE ( Calendario[cuota_n] ), Calendario[anio] <= 2025 )
		formatString: 0.0%
