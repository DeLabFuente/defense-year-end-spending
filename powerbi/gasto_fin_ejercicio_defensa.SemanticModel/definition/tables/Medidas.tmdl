	/// Diferencia en puntos entre noviembre-diciembre y enero-octubre. Positivo: menos competencia en el cierre.
	measure 'Cambio en el cierre: oferta única' = [Oferta única nov-dic línea base] - [Oferta única ene-oct línea base]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10. Defensa frente al resto
		lineageTag: e3a0ed6b-b7c7-4934-b397-cd18e65f22f2

	/// Diferencia en puntos entre noviembre-diciembre y enero-octubre. Positivo: más adjudicación directa en el cierre.
	measure 'Cambio en el cierre: negociado sin publicidad' = [Negociado sin publicidad nov-dic línea base] - [Negociado sin publicidad ene-oct línea base]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10. Defensa frente al resto
		lineageTag: 3a274637-d248-4adc-8b4a-a669358da9c1

	/// 2 de 12 meses.
	measure 'Reparto uniforme nov-dic' = DIVIDE ( 2, 12 )
		formatString: 0.0%
		displayFolder: 10. Defensa frente al resto
		lineageTag: 7332cec8-b087-4760-89cc-cc6e5003bdbf

	/// Parte del importe ordinario del bloque o comparador que corresponde a cada tipo de contrato (2017-2025).
	measure 'Peso del tipo en el importe ordinario' = DIVIDE ( [Importe ordinario línea base (M€)], CALCULATE ( [Importe ordinario línea base (M€)], REMOVEFILTERS ( LineaBase[tipo_contrato], LineaBase[orden_tipo] ) ) )
		formatString: 0.0%
		displayFolder: 10. Defensa frente al resto
		lineageTag: f4b1db32-5d8d-4299-852c-d8d6c3421e2f

