	measure 'Oferta única nov-dic línea base' = DIVIDE ( CALCULATE ( SUM ( LineaBase[n_oferta_unica] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ), KEEPFILTERS ( LineaBase[mes] >= 11 ) ), CALCULATE ( SUM ( LineaBase[n_con_ofertas] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ), KEEPFILTERS ( LineaBase[mes] >= 11 ) ) )
		formatString: 0.0%
