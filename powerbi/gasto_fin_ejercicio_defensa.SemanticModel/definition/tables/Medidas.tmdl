	/// Licitaciones sin acuerdos marco ni programas especiales, 2017-2025, en millones de euros con IVA.
	measure 'Importe ordinario línea base (M€)' = DIVIDE ( CALCULATE ( SUM ( LineaBase[importe_ordinario_eur] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ) ), 1000000 )
		formatString: #,0
		displayFolder: 10. Defensa frente al resto
		lineageTag: 034ec232-9af1-4edf-99a7-023db84ca028

	/// Parte del importe ordinario adjudicada en noviembre y diciembre (2017-2025).
	measure 'Cuota nov-dic línea base (importe)' = DIVIDE ( CALCULATE ( SUM ( LineaBase[importe_ordinario_eur] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ), KEEPFILTERS ( LineaBase[mes] >= 11 ) ), CALCULATE ( SUM ( LineaBase[importe_ordinario_eur] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ) ) )
		formatString: 0.0%
		displayFolder: 10. Defensa frente al resto
		lineageTag: 49826e16-4746-4d75-9265-6dbae91022a5

	/// Parte de las adjudicaciones ordinarias hechas en noviembre y diciembre (2017-2025).
	measure 'Cuota nov-dic línea base (n.º)' = DIVIDE ( CALCULATE ( SUM ( LineaBase[n_ordinario] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ), KEEPFILTERS ( LineaBase[mes] >= 11 ) ), CALCULATE ( SUM ( LineaBase[n_ordinario] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ) ) )
		formatString: 0.0%
		displayFolder: 10. Defensa frente al resto
		lineageTag: 802a2e0e-2104-424c-83ba-d07262927682

	/// Parte de los contratos menores adjudicados en noviembre y diciembre (2018-2025).
	measure 'Cuota nov-dic línea base menores (n.º)' = DIVIDE ( CALCULATE ( SUM ( LineaBase[n_adjudicaciones] ), LineaBase[es_contrato_menor] = "Sí", KEEPFILTERS ( LineaBase[anio] <= 2025 ), KEEPFILTERS ( LineaBase[mes] >= 11 ) ), CALCULATE ( SUM ( LineaBase[n_adjudicaciones] ), LineaBase[es_contrato_menor] = "Sí", KEEPFILTERS ( LineaBase[anio] <= 2025 ) ) )
		formatString: 0.0%
