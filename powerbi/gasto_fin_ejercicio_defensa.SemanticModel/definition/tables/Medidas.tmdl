	measure 'Oferta única ene-oct línea base' = DIVIDE ( CALCULATE ( SUM ( LineaBase[n_oferta_unica] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ), KEEPFILTERS ( LineaBase[mes] <= 10 ) ), CALCULATE ( SUM ( LineaBase[n_con_ofertas] ), LineaBase[es_contrato_menor] = "No", KEEPFILTERS ( LineaBase[anio] <= 2025 ), KEEPFILTERS ( LineaBase[mes] <= 10 ) ) )
		formatString: 0.0%
