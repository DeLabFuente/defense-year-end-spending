/// Rotación y concentración de adjudicatarios por año (huellas anónimas). No se relaciona con el calendario: usa su propia columna anio.
table AdjudicatariosAnual
	lineageTag: 3af51b40-b499-4396-83a8-7db67fa1b6fd

	column anio
		dataType: int64
		formatString: 0
		lineageTag: b4b136ce-5605-48a9-b466-215032b9af85
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = Automatic

	/// Adjudicatarios distintos (huellas) con alguna adjudicación en el año. Sección 14 sin acuerdos marco.
	column adjudicatarios_activos
		dataType: int64
		formatString: #,0
		lineageTag: 0c39d924-3186-47b1-9d87-584edce8c443
