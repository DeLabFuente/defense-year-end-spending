		summarizeBy: none
		sourceColumn: repiten_del_anio_anterior

		annotation SummarizationSetBy = Automatic

	/// Primera adjudicación de la serie en este año (2017-2018 inflados por la baja cobertura inicial).
	column nuevos
		dataType: int64
		formatString: #,0
		lineageTag: 531a65f8-2c5a-43d3-bf48-13b78ba275f0
		summarizeBy: none
