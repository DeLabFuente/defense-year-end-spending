	partition AdjudicatariosAnual = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "adjudicatarios_anual.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Vacios = Table.ReplaceValue(Limpio, "", null, Replacer.ReplaceValue, Table.ColumnNames(Limpio)),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"anio", Int64.Type}, {"adjudicatarios_activos", Int64.Type}, {"repiten_del_anio_anterior", Int64.Type}, {"nuevos", Int64.Type}, {"vuelven_tras_hueco", Int64.Type}, {"se_van", Int64.Type}, {"hhi_ordinario_anio", type number}, {"hhi_ordinario_nov_dic", type number}, {"hhi_ordinario_ene_oct", type number}, {"cuota_top10_ordinario_anio", type number}, {"cuota_top10_ordinario_nov_dic", type number}, {"cuota_top10_ordinario_ene_oct", type number}, {"cuota_habituales_importe_nov_dic", type number}, {"cuota_habituales_importe_ene_oct", type number}, {"cuota_habituales_n_nov_dic", type number}, {"cuota_habituales_n_ene_oct", type number}, {"nota", type text}}, "es-ES")
				in
				    Tipos

	annotation PBI_ResultType = Table

